# ---------------------------------------------------------------------------
# Shared database — read by services/database
# ---------------------------------------------------------------------------
# Required. PostgreSQL connection URL, with the pgvector extension available.
# Example only. Replace the host, user, password, and database name.
DATABASE_URL=postgres://wagglebot:change-me@localhost:5432/wagglebot

# ---------------------------------------------------------------------------
# Auth service — read by services/auth/src/config.ts
# Signs a short-lived EdDSA session token after an SSH key challenge.
# ---------------------------------------------------------------------------
# Required. Address and port the auth service binds. Port range: 1 to 65535.
AUTH_HOST=127.0.0.1
AUTH_PORT=8080
# Required. Public HTTPS URL of this service. Used as the token issuer.
AUTH_ISSUER=https://auth.example.com
# Required. Path to the EdDSA private key that signs session tokens.
AUTH_SIGNING_PRIVATE_KEY_FILE=/config/auth-signing-key.pem
# Required. Path to the company catalog that lists users and their SSH keys.
AUTH_CATALOG_PATH=/config/company-repository/catalog
# Required. Catalog reload interval in seconds. Range: 1 to 86400.
AUTH_CATALOG_REFRESH_SECONDS=60
# Required. Engineer SSH key source: "catalog" or "github".
AUTH_KEY_SOURCE=catalog
# Required only when AUTH_KEY_SOURCE=github. Host serving <user>.keys.
# AUTH_GITHUB_KEYS_HOST=github.com

# ---------------------------------------------------------------------------
# Registry service — read by services/registry/src/config.ts
# Serves the MCP server catalog over HTTP. Not a Docker or npm registry.
# ---------------------------------------------------------------------------
# Required. Address and port the registry binds. Port range: 1 to 65535.
REGISTRY_HOST=127.0.0.1
REGISTRY_PORT=3040
# Required. HTTPS URL of the auth service above. Must match its issuer.
REGISTRY_ISSUER=https://auth.example.com
# Required. Path to the auth service public key in SPKI PEM form.
REGISTRY_AUTH_PUBLIC_KEY_FILE=/config/auth-public-key.pem
# Required. Path to the company repository checkout that holds the catalog.
REGISTRY_COMPANY_ROOT=/config/company-repository
# Required. Exact 40-character lowercase hexadecimal commit SHA being served.
REGISTRY_SOURCE_REVISION=
# Required. Catalog reload interval in seconds. Range: 1 to 86400.
REGISTRY_REFRESH_SECONDS=900
# Required. Response size cap in bytes. Range: 1 to 262144.
REGISTRY_MAX_RESPONSE_BYTES=262144

# ---------------------------------------------------------------------------
# Memory worker — read by services/memory-worker/src/config.ts
# Required PostgreSQL URL; remote databases require sslmode=verify-full and a CA.
MEMORY_DATABASE_URL=postgres://wagglebot:change-me@localhost:5432/wagglebot
# Required for remote databases unless sslrootcert is already in the URL.
# MEMORY_DATABASE_CA=/config/postgres-ca.pem
# Required HTTPS auth issuer and absolute company checkout root.
MEMORY_ISSUER=https://auth.example.com
MEMORY_COMPANY_ROOT=/config/company-repository
# Required SPKI public key, writable model cache, and Gitleaks 8.30.1 pin.
MEMORY_SESSION_TOKEN_PUBLIC_KEY_FILE=/config/auth-public-key.pem
MEMORY_MODEL_CACHE_DIR=/var/cache/wagglebot-memory
MEMORY_GITLEAKS_EXECUTABLE=/usr/local/bin/gitleaks
MEMORY_GITLEAKS_SHA256=replace-with-64-character-lowercase-hex-digest
# Optional listener settings. HTTPS terminates at operator ingress.
MEMORY_HOST=0.0.0.0
MEMORY_PORT=3050
# Required. Operator bearer token used only by the publication and admin HTTP routes.
MEMORY_ADMIN_BEARER_TOKEN=replace-with-high-entropy-token
# Required. JSON map from exact repository identities to absolute local Git checkouts.
MEMORY_PUBLICATION_REPOSITORIES_FILE=/config/publication-repositories.json
# Operator CLI only: worker HTTPS origin (explicit loopback HTTP allowed locally).
# Use the same administrator token above; never pass it as a command argument.
# MEMORY_WORKER_URL=https://memory.example.com

# ---------------------------------------------------------------------------
# Local workstation MCP hub — not read by shared Compose services
# Configure these in the engineer's local environment, not in a shared .env.
# ---------------------------------------------------------------------------
# MCP_HUB_HOST=127.0.0.1
# MCP_HUB_PORT=9000
# MCP_HUB_BEARER_TOKEN=
# MCP_HUB_CONFIG_PATH=
# MCP_HUB_CONFIG_URL=
# MCP_HUB_TRUST_PATH=
# Remote mode requires an HTTPS registry URL and a working local SSH_AUTH_SOCK.
# MCP_HUB_AUTH_URL=
# MCP_HUB_AUTH_USERNAME=
# MCP_HUB_AUTH_PUBLIC_KEY_FILE=
