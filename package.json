{
  "name": "wagglebot-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:codegraph-integration": "CODEGRAPH_INTEGRATION=1 bun test packages/local-brain/integration/codegraph.test.ts",
    "build": "bun run --cwd packages/cli build",
    "regen:test-app": "node scripts/regen-test-app.mjs"
  },
  "overrides": {
    "protobufjs": "7.6.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
